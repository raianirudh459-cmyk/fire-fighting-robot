$('ge').textContent=g.sat?'Reading pinned at maximum. Check the voltage divider.':g.warm>0?'Warming up ('+g.warm+' s left). Readings unreliable.':!g.cal?'Not calibrated. Levels are approximate.':''}}
async function refresh(){const s=await call('/api/state');if(s){if(!online||$('cs').textContent=='Connecting')setOnline(true);render(s)}return s}
async function poll(){const s=await refresh();setTimeout(poll,s?1000:1500)}
poll();
</script></body></html>)rawliteral";

// =========================== HTTP HANDLERS ===========================
static void sendJson(int code, const char* body) {
  server.sendHeader("Cache-Control", "no-store");
  server.send(code, "application/json", body);
}
static void reply(int code, bool ok, const char* msg) {
  char b[96];
  snprintf(b, sizeof b, "{\"ok\":%s,\"msg\":\"%s\"}", ok ? "true" : "false", msg);
  sendJson(code, b);
}

void handleRoot() { server.send_P(200, "text/html", PAGE); }

void handleState() {
  uint32_t now = millis();
  char t[12], h[12], b[420];
  if (dhtOk(now)) { dtostrf(tC, 1, 1, t); dtostrf(hP, 1, 0, h); }
  else            { strcpy(t, "null"); strcpy(h, "null"); }
  unsigned long warm = now < GAS_WARMUP_MS ? (GAS_WARMUP_MS - now) / 1000 + 1 : 0;
  snprintf(b, sizeof b,
    "{\"mode\":\"%s\",\"motion\":\"%c\",\"pump\":%d,\"cool\":%d,\"flame\":[%d,%d,%d],"
    "\"t\":%s,\"h\":%s,"
    "\"gas\":{\"raw\":%u,\"lvl\":%d,\"ok\":%d,\"sat\":%d,\"cal\":%d,\"warm\":%lu},\"trips\":%lu}",
    mode == MODE_AUTO ? "auto" : "manual", (char)motion, pumpOn, pumpCooling,
    fl[0].stable, fl[1].stable, fl[2].stable, t, h,
    (unsigned)gasRaw, gasLevel(), gasOk, gasSat, gasCal, warm, (unsigned long)failsafeTrips);
  sendJson(200, b);
}

void handleDrive() {
  if (mode != MODE_MANUAL) { reply(409, false, "Switch to manual mode first"); return; }
  String d = server.arg("d");
  if (d.length() != 1 || !strchr("FBLRS", d[0])) { reply(400, false, "Bad command"); return; }
  setMotion((Motion)d[0]);
  lastCmdMs = millis();
  reply(200, true, "OK");
}

void handlePump() {
  if (mode != MODE_MANUAL) { reply(409, false, "Switch to manual mode first"); return; }
  String s = server.arg("s");
  if (s != "0" && s != "1") { reply(400, false, "Bad command"); return; }
  pumpWanted = (s == "1");
  lastCmdMs = millis();
  pumpUpdate(lastCmdMs);
  reply(200, true, "OK");
}

void handleMode() {
  String m = server.arg("m");
  if (m != "auto" && m != "manual") { reply(400, false, "Bad mode"); return; }
  setMode(m == "auto" ? MODE_AUTO : MODE_MANUAL);
  reply(200, true, "OK");
}

void handleStop() {            // works in any mode, always lands in idle manual mode
  setMode(MODE_MANUAL);
  reply(200, true, "Stopped");
}

void handleCalibrate() {
  if (millis() < GAS_WARMUP_MS) { reply(409, false, "Sensor still warming up"); return; }
  if (!gasOk)                   { reply(409, false, "MQ-135 not reading"); return; }
  uint32_t s = 0;
  for (uint8_t i = 0; i < 32; i++) { s += analogRead(A0); delay(5); }
  gasBaseline = s / 32; gasCal = true;
  saveCal(gasBaseline);
  reply(200, true, "Clean-air baseline saved");
}

void handleNotFound() {
  if (server.uri() == "/favicon.ico") { server.send(204); return; }
  server.sendHeader("Location", "http://192.168.4.1/");
  server.send(302, "text/plain", "");
}

// =========================== SETUP / LOOP ===========================
void setup() {
  // Outputs to a safe state first
  pinMode(PIN_RELAY, OUTPUT); relayWrite(false);
  pinMode(PIN_IN1, OUTPUT); pinMode(PIN_IN2, OUTPUT);
  pinMode(PIN_IN3, OUTPUT); pinMode(PIN_IN4, OUTPUT);
  analogWriteRange(PWMRANGE);
  digitalWrite(PIN_IN1, LOW); digitalWrite(PIN_IN2, LOW);
  digitalWrite(PIN_IN3, LOW); digitalWrite(PIN_IN4, LOW);
  pinMode(PIN_FLAME_L, INPUT); pinMode(PIN_FLAME_C, INPUT); pinMode(PIN_FLAME_R, INPUT);

  Serial.begin(115200);
  dht.begin();
  loadCal();

  WiFi.persistent(false);
  WiFi.mode(WIFI_AP);
  IPAddress ip(192, 168, 4, 1);
  WiFi.softAPConfig(ip, ip, IPAddress(255, 255, 255, 0));
  if (strlen(AP_PASS) >= 8) WiFi.softAP(AP_SSID, AP_PASS, AP_CHANNEL, false, AP_MAX_CLIENTS);
  else { WiFi.softAP(AP_SSID, (const char*)nullptr, AP_CHANNEL, false, AP_MAX_CLIENTS); Serial.println("WARNING: AP_PASS < 8 chars, AP is OPEN"); }

  server.on("/", HTTP_GET, handleRoot);
  server.on("/api/state", HTTP_GET, handleState);
  server.on("/api/drive", HTTP_GET, handleDrive);
  server.on("/api/pump", HTTP_GET, handlePump);
  server.on("/api/mode", HTTP_GET, handleMode);
  server.on("/api/stop", HTTP_GET, handleStop);
  server.on("/api/calibrate", HTTP_GET, handleCalibrate);
  server.onNotFound(handleNotFound);
  server.begin();

  setMode(BOOT_AUTONOMOUS ? MODE_AUTO : MODE_MANUAL);
  Serial.print("FlameGuard ready: join '"); Serial.print(AP_SSID); Serial.println("' then open http://192.168.4.1");
}

void loop() {
  uint32_t now = millis();
  server.handleClient();
  flameUpdate(now);
  gasUpdate(now);
  dhtUpdate(now);
  if (mode == MODE_AUTO) autonomousStep(now);
  else                   manualFailsafe(now);
  pumpUpdate(now);
}
