/***************************************************************************
  FlameGuard - ESP8266 firefighting robot
  Board   : NodeMCU 1.0 (ESP-12E) or any ESP8266 dev board
  Features: SoftAP dashboard (192.168.4.1), Autonomous + Manual modes,
            3 flame sensors, DHT temp/humidity, MQ-135 air quality,
            relay-driven water pump, motor + pump failsafes.

  Libraries (Arduino Library Manager):
    - "DHT sensor library"  by Adafruit
    - "Adafruit Unified Sensor" by Adafruit
  Board package: "esp8266" by ESP8266 Community (Boards Manager)
  ESP8266WiFi / ESP8266WebServer / EEPROM come with the board package.
***************************************************************************/
#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <EEPROM.h>
#include <DHT.h>

#ifndef PWMRANGE
#define PWMRANGE 1023
#endif

// ============================ USER SETTINGS ============================
// --- Wi-Fi access point ---
const char*   AP_SSID        = "FlameGuard-Robot";
const char*   AP_PASS        = "firefight123";   // 8+ characters, else AP is open
const uint8_t AP_CHANNEL     = 6;
const uint8_t AP_MAX_CLIENTS = 4;

// --- Pins (GPIO numbers; NodeMCU label in comment) ---
const uint8_t PIN_IN1     = 5;   // D1  left  motors  (L298N IN1)
const uint8_t PIN_IN2     = 4;   // D2  left  motors  (L298N IN2)
const uint8_t PIN_IN3     = 14;  // D5  right motors  (L298N IN3)
const uint8_t PIN_IN4     = 12;  // D6  right motors  (L298N IN4)
const uint8_t PIN_DHT     = 13;  // D7  DHT data
const uint8_t PIN_RELAY   = 15;  // D8  pump relay (must be LOW at boot -> use active-HIGH relay)
const uint8_t PIN_FLAME_L = 16;  // D0  left flame sensor  (DO pin)
const uint8_t PIN_FLAME_C = 0;   // D3  centre flame sensor (DO pin)
const uint8_t PIN_FLAME_R = 2;   // D4  right flame sensor (DO pin)
// MQ-135 analog output -> A0 (through a 5V->3.3V divider, see wiring table)

// --- Motors ---
const bool    LEFT_REVERSED   = false;  // flip if the left side drives backwards
const bool    RIGHT_REVERSED  = false;  // flip if the right side drives backwards
const uint8_t DRIVE_SPEED_PCT = 80;     // forward / backward speed
const uint8_t TURN_SPEED_PCT  = 70;     // pivot-turn speed

// --- Flame sensors / firefighting ---
const bool     FLAME_ACTIVE_LOW    = true;   // LM393 modules: DO goes LOW on flame
const uint8_t  FLAME_RANGE_SENSORS = 2;      // centre + this many sensors = "close enough to spray"
const uint32_t FLAME_DEBOUNCE_MS   = 60;
const bool     RELAY_ACTIVE_LOW    = false;  // false = relay ON when GPIO is HIGH
const uint32_t PUMP_LINGER_MS      = 2500;   // keep spraying after flame disappears
const uint32_t PUMP_MAX_ON_MS      = 20000;  // dry-run protection: max continuous spray
const uint32_t PUMP_COOLDOWN_MS    = 5000;   // pause after hitting the max
const bool     SEARCH_ENABLED      = false;  // true = rotate in short pulses when no flame seen
const uint32_t SEARCH_PULSE_MS     = 350;
const uint32_t SEARCH_PERIOD_MS    = 1800;

// --- Manual mode failsafe ---
const uint32_t MANUAL_TIMEOUT_MS = 600;      // no command for this long -> stop motors + pump
const bool     BOOT_AUTONOMOUS   = false;    // false = start in manual (safe) mode

// --- DHT ---
#define DHTTYPE DHT11                        // change to DHT22 if you have one
const uint32_t DHT_PERIOD_MS = 2500;
const uint32_t DHT_STALE_MS  = 10000;        // reading older than this = "unavailable"

// --- MQ-135 (raw ADC, 0-1023) ---
const uint32_t GAS_PERIOD_MS        = 500;
const uint8_t  GAS_SAMPLES          = 8;
const uint32_t GAS_WARMUP_MS        = 180000UL;  // readings unreliable until warmed up
const int      GAS_BASELINE_DEFAULT = 150;       // used until you calibrate in clean air
const int      GAS_MODERATE_DELTA   = 80;        // raw counts above baseline
const int      GAS_POOR_DELTA       = 200;
const int      GAS_HAZARD_DELTA     = 400;
// ======================================================================

enum Mode : uint8_t { MODE_MANUAL, MODE_AUTO };
enum Motion : char { M_STOP = 'S', M_FWD = 'F', M_BACK = 'B', M_LEFT = 'L', M_RIGHT = 'R' };

ESP8266WebServer server(80);
DHT dht(PIN_DHT, DHTTYPE);

Mode     mode = MODE_MANUAL;
Motion   motion = M_STOP;
uint32_t lastCmdMs = 0;
uint32_t failsafeTrips = 0;

// ---- pump state
bool     pumpWanted = false, pumpOn = false, pumpCooling = false;
uint32_t pumpOnSince = 0, pumpCooldownUntil = 0;

// ---- flame state
struct Flame { uint8_t pin; bool raw; bool stable; uint32_t changed; };
Flame fl[3] = { {PIN_FLAME_L, false, false, 0}, {PIN_FLAME_C, false, false, 0}, {PIN_FLAME_R, false, false, 0} };
uint32_t lastInRangeMs = 0, searchStart = 0;

// ---- DHT state
float    tC = NAN, hP = NAN;
uint32_t dhtLastOk = 0;
bool     dhtEver = false;

// ---- MQ-135 state
uint16_t gasRaw = 0;
bool     gasOk = false, gasSat = false, gasCal = false;
int      gasBaseline = GAS_BASELINE_DEFAULT;

// =========================== MOTORS ===========================
static int pct2pwm(uint8_t p) { return (int)((uint32_t)p * PWMRANGE / 100); }

// speed > 0 : A pin PWM, B low.  speed < 0 : reverse.  0 : coast.
static void driveSide(uint8_t pinA, uint8_t pinB, int speed, bool reversed) {
  if (reversed) speed = -speed;
  if (speed > 0)      { analogWrite(pinB, 0); analogWrite(pinA, speed); }
  else if (speed < 0) { analogWrite(pinA, 0); analogWrite(pinB, -speed); }
  else                { analogWrite(pinA, 0); analogWrite(pinB, 0); }
}

void setMotion(Motion m) {
  if (m == motion) return;
  int d = pct2pwm(DRIVE_SPEED_PCT), t = pct2pwm(TURN_SPEED_PCT), l = 0, r = 0;
  switch (m) {
    case M_FWD:   l = d;  r = d;  break;
    case M_BACK:  l = -d; r = -d; break;
    case M_LEFT:  l = -t; r = t;  break;
    case M_RIGHT: l = t;  r = -t; break;
    default:      m = M_STOP;     break;
  }
  driveSide(PIN_IN1, PIN_IN2, l, LEFT_REVERSED);
  driveSide(PIN_IN3, PIN_IN4, r, RIGHT_REVERSED);
  motion = m;
}

// =========================== PUMP ===========================
static void relayWrite(bool on) { digitalWrite(PIN_RELAY, (on != RELAY_ACTIVE_LOW) ? HIGH : LOW); }

// Applies pumpWanted with dry-run protection. Call every loop.
void pumpUpdate(uint32_t now) {
  if (pumpOn) {
    if (!pumpWanted) {
      pumpOn = false; relayWrite(false);
    } else if (now - pumpOnSince >= PUMP_MAX_ON_MS) {
      pumpOn = false; relayWrite(false);
      pumpCooling = true; pumpCooldownUntil = now + PUMP_COOLDOWN_MS;
    }
  } else {
    if (pumpCooling && (int32_t)(now - pumpCooldownUntil) >= 0) pumpCooling = false;
    if (pumpWanted && !pumpCooling) { pumpOn = true; pumpOnSince = now; relayWrite(true); }
  }
}

// =========================== SENSORS ===========================
void flameUpdate(uint32_t now) {
  for (uint8_t i = 0; i < 3; i++) {
    bool a = (digitalRead(fl[i].pin) == (FLAME_ACTIVE_LOW ? LOW : HIGH));
    if (a != fl[i].raw) { fl[i].raw = a; fl[i].changed = now; }
    if (fl[i].stable != fl[i].raw && now - fl[i].changed >= FLAME_DEBOUNCE_MS) fl[i].stable = fl[i].raw;
  }
}

void dhtUpdate(uint32_t now) {
  static uint32_t last = 0;
  if (now - last < DHT_PERIOD_MS) return;
  last = now;
  float h = dht.readHumidity(), t = dht.readTemperature();
  if (isnan(h) || isnan(t) || h < 0 || h > 100 || t < -40 || t > 80) return;  // keep old value; goes stale
  tC = t; hP = h; dhtLastOk = now; dhtEver = true;
}
bool dhtOk(uint32_t now) { return dhtEver && (now - dhtLastOk < DHT_STALE_MS); }

void gasUpdate(uint32_t now) {
  static uint32_t last = 0;
  if (now - last < GAS_PERIOD_MS) return;
  last = now;
  uint32_t s = 0;
  for (uint8_t i = 0; i < GAS_SAMPLES; i++) { s += analogRead(A0); delayMicroseconds(200); }
  gasRaw = s / GAS_SAMPLES;
  gasOk  = gasRaw > 3;        // ~0 = sensor unpowered / wire missing
  gasSat = gasRaw >= 1020;    // pinned at full scale = divider/wiring problem
}
int gasLevel() {
  int d = (int)gasRaw - gasBaseline;
  if (d < GAS_MODERATE_DELTA) return 0;   // good
  if (d < GAS_POOR_DELTA)     return 1;   // moderate
  if (d < GAS_HAZARD_DELTA)   return 2;   // poor
  return 3;                               // hazardous
}
void loadCal() {
  EEPROM.begin(8);
  uint16_t magic = 0, b = 0;
  EEPROM.get(0, magic); EEPROM.get(2, b);
  if (magic == 0xA55A && b <= 1023) { gasBaseline = b; gasCal = true; }
}
void saveCal(uint16_t b) {
  uint16_t magic = 0xA55A;
  EEPROM.put(0, magic); EEPROM.put(2, b); EEPROM.commit();
}

// =========================== CONTROL LOGIC ===========================
// Safe mode change: everything the old mode was doing is cancelled.
void setMode(Mode m) {
  setMotion(M_STOP);
  pumpWanted = false;
  pumpUpdate(millis());
  mode = m;
  lastCmdMs = 0;
  lastInRangeMs = 0;
  searchStart = millis();
}

void autonomousStep(uint32_t now) {
  bool l = fl[0].stable, c = fl[1].stable, r = fl[2].stable;
  uint8_t n = l + c + r;
  bool inRange = c && n >= FLAME_RANGE_SENSORS;
  if (inRange) lastInRangeMs = now;
  bool lingering = pumpOn && (now - lastInRangeMs < PUMP_LINGER_MS);
  pumpWanted = inRange || lingering;

  if (inRange || lingering)    setMotion(M_STOP);                 // in range: hold still and spray
  else if (n == 0) {
    if (SEARCH_ENABLED) setMotion(((now - searchStart) % SEARCH_PERIOD_MS) < SEARCH_PULSE_MS ? M_RIGHT : M_STOP);
    else                setMotion(M_STOP);
  }
  else if (c)                  setMotion(M_FWD);
  else if (l && !r)            setMotion(M_LEFT);
  else if (r && !l)            setMotion(M_RIGHT);
  else                         setMotion(M_FWD);                  // left + right, no centre
}

void manualFailsafe(uint32_t now) {
  if (motion == M_STOP && !pumpWanted) return;
  if (now - lastCmdMs > MANUAL_TIMEOUT_MS || WiFi.softAPgetStationNum() == 0) {
    setMotion(M_STOP);
    pumpWanted = false;
    failsafeTrips++;
  }
}

